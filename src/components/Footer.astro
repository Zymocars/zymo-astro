<style>
  .z-footer {
    background: var(--z-bg-soft);
    color: var(--z-fg);
    padding: var(--z-space-8) var(--z-space-6);
    border-top-left-radius: var(--z-radius-lg);
    border-top-right-radius: var(--z-radius-lg);
    margin-top: var(--z-space-12);
  }

  .z-footer-grid {
    max-width: var(--z-container-wide);
    margin: 0 auto;
    display: grid;
    gap: var(--z-space-6);
    grid-template-columns: repeat(2, 1fr);
  }

  @media (min-width: 640px) {
    .z-footer-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 768px) {
    .z-footer-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .z-footer-grid {
      grid-template-columns: repeat(6, 1fr);
    }
  }

  .z-footer-col {
    display: flex;
    flex-direction: column;
    gap: var(--z-space-2);
  }

  .z-footer-heading {
    font-size: var(--z-text-xl);
    font-weight: 800;
    color: var(--z-fg-strong);
    margin: 0 0 var(--z-space-3);
  }

  .z-footer-body {
    color: var(--z-fg-muted);
    font-size: var(--z-text-sm);
    margin: 0 0 var(--z-space-2);
  }

  .z-footer-col a {
    color: var(--z-fg);
    font-size: var(--z-text-sm);
    text-decoration: none;
  }

  /* Link underline (matches word width) — reproduced from Footer.tsx:29-42 */
  .z-link-hover {
    position: relative;
    display: inline-block;
    width: fit-content;
  }

  .z-link-hover::after {
    content: "";
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 2px;
    background: linear-gradient(to right, #3b82f6, #a855f7);
    transition: width 0.3s ease;
  }

  .z-link-hover:hover::after {
    width: 100%;
  }

  .z-footer-view-all {
    color: var(--z-brand-purple);
    font-size: var(--z-text-sm);
    margin-top: var(--z-space-2);
  }

  .z-footer-zai {
    color: var(--z-brand-purple);
    font-weight: 500;
  }

  .z-footer-app-badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--z-space-3);
    margin: var(--z-space-2) 0;
  }

  .z-footer-app-badges img {
    height: 40px;
    width: auto;
  }

  .z-footer-payment-icons {
    display: flex;
    gap: var(--z-space-4);
    margin-top: var(--z-space-2);
  }

  .z-footer-payment-icons img {
    height: 24px;
    width: auto;
  }

  .z-footer-social {
    display: flex;
    gap: var(--z-space-5);
    margin-top: var(--z-space-2);
  }

  .z-footer-social a {
    color: var(--z-fg-strong);
    transition: transform var(--z-motion-fast), color var(--z-motion-fast);
  }

  .z-footer-social a:hover {
    color: var(--z-brand-purple);
    transform: scale(1.15);
  }

  .z-footer-compliance {
    max-width: var(--z-container-wide);
    margin: var(--z-space-8) auto 0;
    padding-top: var(--z-space-6);
    border-top: 1px solid var(--z-bg-hover);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--z-space-4);
    font-size: var(--z-text-sm);
    color: var(--z-fg-muted);
  }

  .z-footer-copyright {
    text-align: center;
    color: var(--z-fg-muted);
    font-size: var(--z-text-sm);
    margin-top: var(--z-space-4);
  }
</style>
