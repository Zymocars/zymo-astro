---
// NavBar.astro — static top nav for the SEO surface.
// Verified port of the nav-link set and logo asset from
// zymo-web/src/components/NavBar.tsx:20-26, 66-81 (read this session).
// The React-only bits (auth listener, chat bubble timer, ThemeToggle, profile
// state, city bubble prop) are intentionally omitted — SEO pages ship with no
// auth-aware chrome. Mobile toggle uses the native <details> element instead of
// useState so there is zero JS on the SEO surface.
---

<nav aria-label="Main navigation" class="z-nav">
  <div class="z-nav-inner">
    <a href="/" class="z-nav-logo" aria-label="Zymo — self-drive car rentals">
      <img
        src="/images/AppLogo/zymo-logo-128.webp"
        alt="Zymo Logo"
        width="128"
        height="128"
        decoding="async"
      />
    </a>

    <details class="z-nav-menu">
      <summary class="z-nav-menu-toggle" aria-label="Toggle navigation menu">
        <svg
          width="28"
          height="28"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="4" y1="6" x2="20" y2="6" />
          <line x1="4" y1="12" x2="20" y2="12" />
          <line x1="4" y1="18" x2="20" y2="18" />
        </svg>
      </summary>

      <ul class="z-nav-links">
        <li><a href="/">Home</a></li>
        <li><a href="/about-us">About Us</a></li>
        <li><a href="/blogs">Blogs</a></li>
        <li><a href="/career">Career</a></li>
        <li><a href="/contact-us">Contact Us</a></li>
        <li>
          <a href="https://partner.zymo.app/homepage" target="_blank" rel="noreferrer">
            Partner with Us
          </a>
        </li>
      </ul>
    </details>
  </div>
</nav>

<style>
  .z-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--z-bg);
    box-shadow: var(--z-shadow-nav);
  }

  .z-nav-inner {
    max-width: var(--z-container-wide);
    margin: 0 auto;
    padding: var(--z-space-3) var(--z-space-4);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--z-space-4);
    min-height: 64px;
  }

  .z-nav-logo {
    display: inline-flex;
    align-items: center;
  }

  .z-nav-logo img {
    height: 40px;
    width: auto;
  }

  .z-nav-menu {
    position: relative;
  }

  .z-nav-menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    padding: var(--z-space-2);
    background: transparent;
    border: 0;
    cursor: pointer;
    color: var(--z-fg-strong);
    list-style: none;
  }

  .z-nav-menu-toggle::-webkit-details-marker {
    display: none;
  }

  .z-nav-links {
    position: absolute;
    right: 0;
    top: calc(100% + var(--z-space-2));
    background: var(--z-bg-soft);
    border: 1px solid var(--z-bg-hover);
    border-radius: var(--z-radius-md);
    box-shadow: var(--z-shadow-card);
    list-style: none;
    margin: 0;
    padding: var(--z-space-2);
    min-width: 220px;
  }

  .z-nav-links li {
    margin: 0;
  }

  .z-nav-links a {
    display: block;
    padding: var(--z-space-3);
    color: var(--z-fg-strong);
    font-weight: 600;
    border-radius: var(--z-radius-sm);
    transition: background var(--z-motion-fast);
  }

  .z-nav-links a:hover {
    background: var(--z-bg-hover);
    text-decoration: none;
  }

  @media (min-width: 768px) {
    .z-nav-menu {
      position: static;
    }

    .z-nav-menu-toggle {
      display: none;
    }

    .z-nav-menu > .z-nav-links {
      position: static;
      display: flex;
      gap: var(--z-space-3);
      background: transparent;
      border: 0;
      box-shadow: none;
      padding: 0;
      min-width: auto;
    }

    .z-nav-links a {
      padding: var(--z-space-2) var(--z-space-3);
    }
  }
</style>
