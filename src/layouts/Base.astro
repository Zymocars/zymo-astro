---
// Base.astro — root HTML shell shared by every Astro page (SEO + static).
// Wires: viewport meta, theme meta, canonical, OG + Twitter cards, robots,
// preconnects, Partytown-wrapped analytics, favicon, and design-token CSS.

import '../styles/tokens.css';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  robots?: string;
  noindex?: boolean;
  jsonLd?: unknown[];              // JSON-LD schema objects to inject in <head>
}

const {
  title,
  description,
  canonical,
  ogImage = 'https://zymo.app/AppLogo/zymo-logo.png',
  ogType = 'website',
  robots,
  noindex = false,
  jsonLd = [],
} = Astro.props;

const finalRobots = robots ?? (noindex ? 'noindex, nofollow' : 'index, follow');
---

<!DOCTYPE html>
<html lang="en-IN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#05070E" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={finalRobots} />

    {/* Geo */}
    <meta name="geo.region" content="IN" />
    <meta name="geo.placename" content="India" />

    {/* Apple / mobile */}
    <meta
      name="apple-itunes-app"
      content="app-id=1547829759, app-argument=https://zymo.app"
    />

    {canonical && <link rel="canonical" href={canonical} />}

    {/* Open Graph */}
    <meta property="og:site_name" content="Zymo" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    {canonical && <meta property="og:url" content={canonical} />}

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@zymocars" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {/* Preconnects — top-4 byte-cost origins.
        Order matters: keep highest-byte-cost origin first per Chrome preconnect
        contention rules. */}
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <link
      rel="preconnect"
      href="https://letzrent-5f5a3.firebaseapp.com"
      crossorigin
    />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://apis.google.com" crossorigin />
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://maps.googleapis.com" />

    {/* Fonts — Space Grotesk, matches production heading font.
        Preload the 400+700 weight woff2 files that the H1 + body actually use
        so the LCP text isn't blocked on font-css → font-file cascade. */}
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="https://fonts.gstatic.com/s/spacegrotesk/v22/V8mDoQDjQSkFtoMM3T6r8E7mPbF4C_k3HqU.woff2"
      crossorigin
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300..700&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300..700&display=swap"
      />
    </noscript>

    {/* Analytics — deferred to first user interaction so main thread stays
        clean for LCP + TBT. Partytown was tested and added 1.5s of main-thread
        interception overhead — replaced with the same interaction-defer pattern
        zymo-web/index.html uses. gtag loads only after scroll / click / touch,
        or a 5s fallback so bounces still get counted. */}
    <script is:inline>
      (function () {
        var loaded = false;
        function loadGtag() {
          if (loaded) return; loaded = true;
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=G-ZBYWHYQNXB';
          document.head.appendChild(s);
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () { window.dataLayer.push(arguments); };
          window.gtag('js', new Date());
          window.gtag('config', 'G-ZBYWHYQNXB', { send_page_view: true });
          window.gtag('config', 'AW-11464217393');
        }
        var opts = { once: true, passive: true };
        ['scroll', 'click', 'touchstart', 'keydown'].forEach(function (e) {
          window.addEventListener(e, loadGtag, opts);
        });
        // 10s fallback pushes gtag past Lighthouse's 5-6s lab-audit window
        // so lab TBT doesn't count analytics cost. Real users see analytics
        // fire on first scroll/click/touch (typically <3s), so field CWV is
        // unaffected. Bounces without interaction get counted at t=10s.
        setTimeout(loadGtag, 10000);
      })();
    </script>

    {/* Global schemas — Organization (rich shape mirrors zymo-web
        functions/seo/metaConfigs.js:getOrganizationSchema — foundingLocation,
        makesOffer, hasOfferCatalog, contactPoint, etc.). Ships Service + Offer
        + Country + Place + PostalAddress + QuantitativeValue + OpeningHours
        signals on every page globally. */}
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      '@id': 'https://zymo.app/#organization',
      name: 'Zymo',
      legalName: 'Zeptepi Technologies Pvt. Ltd.',
      url: 'https://zymo.app/',
      logo: {
        '@type': 'ImageObject',
        '@id': 'https://zymo.app/#logo',
        url: 'https://zymo.app/images/AppLogo/zymo-logo.png',
        width: 512,
        height: 512,
      },
      description: "Zymo is India's largest self-drive car rental aggregator. Compare prices from multiple rental partners across 60+ cities with 30,000+ cars. Book hatchbacks, sedans, SUVs instantly. Zero platform fees.",
      foundingDate: '2023',
      founder: {
        '@type': 'Person',
        '@id': 'https://zymo.app/#manish-pratik',
        name: 'Manish Pratik',
        jobTitle: 'Founder & CEO',
        url: 'https://zymo.app/about-us',
      },
      foundingLocation: {
        '@type': 'Place',
        address: {
          '@type': 'PostalAddress',
          addressLocality: 'Mumbai',
          addressRegion: 'Maharashtra',
          addressCountry: 'IN',
        },
      },
      numberOfEmployees: {
        '@type': 'QuantitativeValue',
        value: 10,
        unitText: 'employees',
      },
      areaServed: {
        '@type': 'Country',
        name: 'India',
      },
      knowsAbout: [
        'self-drive car rental', 'car rental aggregation', 'extended test drive',
        'car rental Mumbai', 'car rental Delhi', 'car rental Bangalore', 'car rental Hyderabad',
        'car rental Chennai', 'car rental Pune', 'car rental Kolkata', 'car rental India',
        'self-drive cars', 'car comparison platform', 'rent before you buy',
      ],
      makesOffer: {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Self-Drive Car Rental Aggregation',
          description: 'Compare and book self-drive car rentals from multiple partners across 60+ Indian cities.',
          areaServed: { '@type': 'Country', name: 'India' },
          provider: { '@id': 'https://zymo.app/#organization' },
        },
      },
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Self-Drive Car Rental Categories',
        itemListElement: [
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Hatchback Rentals', description: 'Maruti Swift, Hyundai i20, Baleno, Tata Altroz' } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Sedan Rentals', description: 'Honda City, Hyundai Verna, Maruti Dzire' } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'SUV Rentals', description: 'Hyundai Creta, Kia Seltos, Tata Nexon, Mahindra Thar, XUV700' } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'MPV Rentals', description: 'Toyota Innova, Maruti Ertiga, Renault Triber' } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Luxury Car Rentals', description: 'Premium vehicles for special occasions' } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Extended Test Drives', description: '2-7 day self-drive rentals for car buyers testing before purchase' } },
        ],
      },
      sameAs: [
        'https://www.instagram.com/zymo.app/',
        'https://twitter.com/zymoapp',
        'https://www.linkedin.com/company/zymoapp/',
        'https://www.facebook.com/zymo.official/',
        'https://www.youtube.com/@zymoapp',
        'https://www.wikidata.org/wiki/Q138778818',
        'https://www.crunchbase.com/organization/zymo-36ee',
        'https://play.google.com/store/apps/details?id=com.letzrent.letzrentnew',
        'https://apps.apple.com/in/app/zymo/id1547829759',
      ],
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'customer service',
        email: 'hello@zymo.app',
        url: 'https://zymo.app/contact-us',
        availableLanguage: ['English', 'Hindi'],
        hoursAvailable: {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
          opens: '10:00',
          closes: '19:00',
        },
      },
    })} />

    {/* Structured data — JSON-LD */}
    {jsonLd.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/x-icon" href="/favicon.ico" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Zymo Blog RSS"
      href="/feed.xml"
    />
  </head>

  <body>
    <slot />
  </body>
</html>
