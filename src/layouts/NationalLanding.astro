---
// NationalLanding.astro — shared layout for the 6 national landing pages
// (self-drive-car-rental-india, cheap-car-rental-india, car-rental-without-
// deposit, suv-rental-india, car-rental-app, zoomcar-car-rental).
//
// Each landing has a distinct root-level URL rather than a shared `/national/*`
// prefix, so we use per-URL Astro pages that thin-wrap this component instead
// of a single dynamic route. Callers pass the collection entry slug via a
// prop; the layout loads that entry from the `national` collection and renders
// the raw bodyHtml verbatim via <Fragment set:html>.

import { getEntry } from 'astro:content';
import SeoPage from './SeoPage.astro';
import '../components/SearchWidget/search-widget.css';

export interface Props {
  slug: string;
}

const { slug } = Astro.props;

const entry = await getEntry('national', slug);
if (!entry) {
  throw new Error(`No national landing entry found for slug="${slug}"`);
}

const {
  title,
  description,
  canonical,
  body,
  faqs,
} = entry.data;

// -----------------------------------------------------------------------------
// JSON-LD
// -----------------------------------------------------------------------------
const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${canonical}#webpage`,
  url: canonical,
  name: title,
  description,
  inLanguage: 'en-IN',
  isPartOf: { '@id': 'https://zymo.app/#website' },
  publisher: {
    '@type': 'Organization',
    name: 'Zymo',
    logo: {
      '@type': 'ImageObject',
      url: 'https://zymo.app/AppLogo/zymo-logo.png',
    },
  },
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['[data-speakable]'],
  },
};

const jsonLd: unknown[] = [webPageSchema];

if (faqs && faqs.length > 0) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  });
}
---

<SeoPage
  title={title}
  description={description}
  canonical={canonical}
  ogImage="https://zymo.app/images/AppLogo/zymo-logo.png"
  ogType="website"
  jsonLd={jsonLd}
>
  <article class="z-landing">
    {/*
      Landing body content — raw HTML from
      zymo-backend/functions/seo/landingContent.js generators. Inline styles
      preserved verbatim. `set:html` is safe because the source is our own
      migration pipeline.
    */}
    <Fragment set:html={body} />

    {/* Search widget for landings that funnel to booking. Passing city="mumbai"
        as the default; users can change on the widget. */}
    <div class="z-landing-search z-container">
      <zymo-search city="mumbai"></zymo-search>
    </div>
  </article>

  <script>
    import '../components/SearchWidget/search-widget.ts';
  </script>
</SeoPage>

<style>
  .z-landing {
    /* Landing HTML already has its own max-width via the ARTICLE_STYLE from
       zymo-backend/functions/seo/landingContent.js:31. We just let the inline
       styles win and center. */
    margin: 0 auto;
  }

  .z-landing-search {
    max-width: var(--z-container-max);
    padding: var(--z-space-4);
    margin: var(--z-space-4) auto;
  }
</style>
