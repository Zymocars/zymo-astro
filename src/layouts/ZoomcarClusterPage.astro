---
// ZoomcarClusterPage.astro — shared layout for the 66 root-level ZoomCar
// cluster pages (e.g. /zoomcar-alternative, /is-zoomcar-safe,
// /zoomcar-review-india, /zoomcar-mumbai-to-goa).
//
// Called from the individual per-slug page files generated by
// scripts/migrate-zoomcar-cluster-content.mjs.

import { getEntry } from 'astro:content';
import SeoPage from './SeoPage.astro';

export interface Props {
  slug: string;
}

const { slug } = Astro.props;
const entry = await getEntry('zoomcarClusters', slug);
if (!entry) throw new Error(`No zoomcar-cluster entry for slug="${slug}"`);

const { title, description, canonical, bodyHtml, faqs } = entry.data;

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${canonical}#webpage`,
  url: canonical,
  name: title,
  description,
  inLanguage: 'en-IN',
  isPartOf: { '@id': 'https://zymo.app/#website' },
  speakable: { '@type': 'SpeakableSpecification', cssSelector: ['[data-speakable]'] },
};
const jsonLd: unknown[] = [webPageSchema];
if (faqs && faqs.length > 0) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  });
}
---

<SeoPage
  title={title}
  description={description}
  canonical={canonical}
  ogType="website"
  jsonLd={jsonLd}
>
  <article class="z-zoomcar-cluster">
    <Fragment set:html={bodyHtml} />
  </article>
</SeoPage>

<style>
  .z-zoomcar-cluster {
    max-width: var(--z-container-max);
    margin: 0 auto;
    padding: var(--z-space-4);
  }
</style>
