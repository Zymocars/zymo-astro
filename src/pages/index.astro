---
// Homepage — /
// Renders the migrated SSR content from zymo-backend/functions/seo/
// homeContent.js generateHomepageContentHtml + mounts the NewRSB search
// widget as a React island above the fold.

import { getEntry } from 'astro:content';
import SeoPage from '../layouts/SeoPage.astro';
import NewRSBIsland from '../components/react-island/NewRSBIsland';

const entry = await getEntry('homepage', 'index');
if (!entry) throw new Error('No homepage entry — run scripts/migrate-homepage-content.mjs');

const { title, description, canonical, bodyHtml, schemas: prebuiltSchemas } = entry.data;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': 'https://zymo.app/#organization',
  name: 'Zymo',
  legalName: 'Zeptepi Technologies Pvt. Ltd.',
  url: 'https://zymo.app',
  logo: {
    '@type': 'ImageObject',
    url: 'https://zymo.app/AppLogo/zymo-logo.png',
    width: 512,
    height: 512,
  },
  sameAs: [
    'https://www.instagram.com/zymo.app/',
    'https://www.linkedin.com/company/zymoapp',
    'https://x.com/zymoapp',
    'https://www.facebook.com/zymo.official/',
    'https://www.youtube.com/channel/UCHUvrPwNYxw7bukWFjhNpag',
  ],
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: '+91-22-69620852',
    contactType: 'customer support',
    email: 'hello@zymo.app',
    areaServed: 'IN',
    availableLanguage: ['English', 'Hindi'],
  },
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': 'https://zymo.app/#website',
  url: 'https://zymo.app/',
  name: 'Zymo',
  description,
  publisher: { '@id': 'https://zymo.app/#organization' },
  inLanguage: 'en-IN',
};

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${canonical}#webpage`,
  url: canonical,
  name: title,
  description,
  inLanguage: 'en-IN',
  isPartOf: { '@id': 'https://zymo.app/#website' },
  speakable: { '@type': 'SpeakableSpecification', cssSelector: ['[data-speakable]'] },
};

// Emit prebuilt schemas from backend (FAQPage + HowTo + WebSite + MobileApp x2)
// alongside the local Org/WebSite/WebPage triple. Backend schemas match prod
// rich-result-eligible types (Question x16, Answer x16, HowToStep x4,
// MobileApplication x2 with AggregateRating x2, WebSite SearchAction).
const jsonLd = (prebuiltSchemas && prebuiltSchemas.length > 0)
  ? [orgSchema, websiteSchema, webPageSchema, ...(prebuiltSchemas as unknown[])]
  : [orgSchema, websiteSchema, webPageSchema];
---

<SeoPage title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <article class="z-home">
    <div class="z-home-search z-container">
      <NewRSBIsland client:only="react" />
    </div>
    <Fragment set:html={bodyHtml} />
  </article>
</SeoPage>

<style>
  .z-home { max-width: var(--z-container-max); margin: 0 auto; padding: var(--z-space-4); }
  .z-home-search {
    max-width: var(--z-container-max);
    padding: var(--z-space-4);
    margin: 0 auto var(--z-space-6);
    min-height: 520px;
  }
</style>
