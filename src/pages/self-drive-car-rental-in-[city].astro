---
// Dynamic city page — one Astro template renders every city in the
// `cities` content collection at build time via getStaticPaths().
// Ported to DS 2.0 chrome (gradient H1, overline, dark cards) to match
// zymo-web/src/pages/CityLandingScreenZ2.tsx while keeping zero React.

import { getCollection, getEntry } from 'astro:content';
import SeoPage from '../layouts/SeoPage.astro';
import '../components/SearchWidget/search-widget.css';

export async function getStaticPaths() {
  const cities = await getCollection('cities');
  return cities.map((entry) => ({
    params: { city: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props as { entry: Awaited<ReturnType<typeof getEntry<'cities', string>>> };

if (!entry) {
  throw new Error(`No city entry for param city="${Astro.params.city}"`);
}

const {
  slug,
  cityName,
  title,
  description,
  canonical,
  answerBlock,
  intro,
  popularAreas,
  nearbyDestinations,
  tips,
  carTypes,
  whyZymo,
  howItWorks,
  priceNote,
  faqs,
  h1: h1Override,
  bodyHtml,
  schemas: prebuiltSchemas,
  ogImageFile,
} = entry.data;

const h1Text = h1Override || `Self-Drive Car Rental in ${cityName}`;
const ogImage = ogImageFile
  ? `https://zymo.app/images/CityCars%26Price/${ogImageFile}`
  : 'https://zymo.app/images/AppLogo/zymo-logo.png';

// If backend-migrated schemas are present, use them for byte-parity with prod SSR.
// Otherwise fall back to the minimal inline 3-schema stack.
let jsonLd: any[];
if (prebuiltSchemas && prebuiltSchemas.length > 0) {
  jsonLd = prebuiltSchemas as any[];
} else {
  const localBusinessSchema = {
    '@context': 'https://schema.org',
    '@type': 'LocalBusiness',
    '@id': `${canonical}#carrental`,
    name: `Zymo self-drive car rental — ${cityName}`,
    url: canonical,
    image: ogImage,
    description,
    priceRange: '₹₹',
    address: {
      '@type': 'PostalAddress',
      addressLocality: cityName,
      addressCountry: 'IN',
    },
    areaServed: {
      '@type': 'City',
      name: cityName,
    },
  };
  const breadcrumbSchema = {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://zymo.app/' },
      { '@type': 'ListItem', position: 2, name: 'Self-Drive Car Rentals', item: 'https://zymo.app/self-drive-car-rental-india' },
      { '@type': 'ListItem', position: 3, name: cityName, item: canonical },
    ],
  };
  const faqSchema = {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: (faqs || []).map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  };
  jsonLd = [localBusinessSchema, breadcrumbSchema, faqSchema];
}

// Always emit FAQPage schema from front-matter faqs if not already in prebuiltSchemas
const hasFaqPage = jsonLd.some((s: any) => s && s['@type'] === 'FAQPage');
if (!hasFaqPage && faqs && faqs.length > 0) {
  jsonLd = [...jsonLd, {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  }];
}
---

<SeoPage
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  ogType="website"
  jsonLd={jsonLd}
>
  <main class="z-city-main">
    <section class="z-city-hero z-container">
      <nav class="z-breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li aria-hidden="true">›</li>
          <li><a href="/self-drive-car-rental-india">Self-Drive</a></li>
          <li aria-hidden="true">›</li>
          <li aria-current="page">{cityName}</li>
        </ol>
      </nav>

      <p class="z-overline">Self-drive car rental in {cityName}</p>

      <h1 class="z-hero-h1">{h1Text}</h1>

      <div class="z-chips">
        <span class="z-chip"><span class="z-chip-dot">✓</span> Compare multiple providers</span>
        <span class="z-chip"><span class="z-chip-dot">✓</span> No hidden Zymo fees</span>
        <span class="z-chip"><span class="z-chip-dot">✓</span> Book in 60 seconds</span>
      </div>

      <div class="z-search-card">
        <p class="z-search-title">Great deals, Smooth drives</p>
        <zymo-search city={slug}></zymo-search>
      </div>

      <p class="z-answer-block" data-speakable="true">{answerBlock}</p>
    </section>

    {bodyHtml ? (
      <div class="z-container z-body-html" set:html={bodyHtml} />
    ) : (
      <>
        <section class="z-container z-card">
          <h2>Self-drive car rentals in {cityName} with Zymo</h2>
          <p>{intro}</p>
          <div class="z-two-col">
            <div>
              <h3>Why book self-drive cars in {cityName} with Zymo?</h3>
              <ul>
                <li>Compare multiple rental partners in one place</li>
                <li>Transparent pricing with no hidden Zymo fees</li>
                <li>Options for low or zero security deposit (depending on partner)</li>
                <li>App available on Android and iOS for easy booking</li>
                <li>Support for outstation, local and airport trips</li>
              </ul>
            </div>
            <div>
              <h3>Popular pickup areas in {cityName}</h3>
              <p>{popularAreas.join(' • ')}</p>
            </div>
          </div>
        </section>

        <section class="z-container z-card">
          <h2>Road trips from {cityName}</h2>
          <p>Popular destinations you can drive to from {cityName}:</p>
          <ul>
            {nearbyDestinations.map((dest) => <li>{dest}</li>)}
          </ul>
          <h3>Driving tips for {cityName}</h3>
          <p>{tips}</p>
        </section>

        <section class="z-container z-card">
          <h2>Best cars to book in {cityName}</h2>
          <p>{carTypes}</p>
          <h3>Why book from Zymo in {cityName}?</h3>
          <p>{whyZymo}</p>
          <h3>How to book a self-drive car in {cityName}</h3>
          <p>{howItWorks}</p>
        </section>

        <section class="z-container z-card">
          <h2 id="prices">{cityName} self-drive car rental prices</h2>
          <p>{priceNote}</p>
        </section>

        <section class="z-container z-card">
          <h2>Frequently asked questions about self-drive cars in {cityName}</h2>
          <div class="z-faq">
            {faqs.map((f) => (
              <details class="z-faq-item">
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))}
          </div>
        </section>
      </>
    )}
  </main>

  <script>
    import '../components/SearchWidget/search-widget.ts';
  </script>
</SeoPage>

<style>
  .z-city-main {
    background: var(--z-bg);
    color: var(--z-fg);
    padding: var(--z-space-8) 0 var(--z-space-12);
  }

  .z-container {
    max-width: 1200px;
    margin: 0 auto;
    padding-left: var(--z-space-4);
    padding-right: var(--z-space-4);
  }

  @media (min-width: 640px) {
    .z-container { padding-left: var(--z-space-6); padding-right: var(--z-space-6); }
  }
  @media (min-width: 1024px) {
    .z-container { padding-left: var(--z-space-8); padding-right: var(--z-space-8); }
  }

  .z-city-hero {
    padding-top: var(--z-space-6);
    padding-bottom: var(--z-space-8);
  }

  .z-breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--z-space-2);
    list-style: none;
    padding: 0;
    margin: 0 0 var(--z-space-4);
    font-size: var(--z-text-sm);
    color: var(--z-fg-muted);
  }
  .z-breadcrumb a { color: var(--z-fg-muted); text-decoration: none; }
  .z-breadcrumb a:hover { color: var(--z-fg); }

  .z-overline {
    font-size: var(--z-text-xs);
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: #c4b5fd;
    margin: 0 0 var(--z-space-4);
    font-weight: 600;
  }

  .z-hero-h1 {
    font-size: 2rem;
    line-height: 1.15;
    font-weight: 700;
    color: var(--z-fg-strong);
    max-width: 48rem;
    margin: 0 0 var(--z-space-6);
  }
  @media (min-width: 768px) {
    .z-hero-h1 { font-size: 2.5rem; }
  }
  @media (min-width: 1024px) {
    .z-hero-h1 { font-size: 3rem; }
  }

  .z-grad {
    background: linear-gradient(90deg, #60a5fa 0%, #c084fc 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .z-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--z-space-3);
    margin: 0 0 var(--z-space-6);
  }
  .z-chip {
    display: inline-flex;
    align-items: center;
    gap: var(--z-space-2);
    padding: var(--z-space-2) var(--z-space-4);
    background: #0b1220;
    border: 1px solid #1f2937;
    border-radius: var(--z-radius-full);
    font-size: var(--z-text-sm);
    font-weight: 600;
    color: var(--z-fg-strong);
  }
  .z-chip-dot {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px; height: 18px;
    background: #10b981;
    color: #04121a;
    border-radius: var(--z-radius-full);
    font-size: 12px;
    font-weight: 800;
  }

  .z-search-card {
    background: rgba(2, 6, 23, 0.6);
    border: 1px solid #1f2937;
    border-radius: 20px;
    box-shadow: 0 0 40px rgba(0,0,0,0.6);
    padding: var(--z-space-6);
    margin: 0 0 var(--z-space-6);
  }
  .z-search-title {
    text-align: center;
    font-weight: 600;
    color: var(--z-fg-strong);
    margin: 0 0 var(--z-space-4);
  }

  .z-answer-block {
    font-size: var(--z-text-base);
    color: var(--z-fg);
    line-height: 1.8;
    margin: 0 0 var(--z-space-6);
    max-width: 56rem;
  }

  .z-hero-img {
    width: 100%;
    height: auto;
    aspect-ratio: 1200 / 600;
    border-radius: 20px;
    margin: 0 0 var(--z-space-4);
    background: var(--z-bg-soft);
  }

  .z-card {
    background: rgba(2, 6, 23, 0.7);
    border: 1px solid #1f2937;
    border-radius: 20px;
    padding: var(--z-space-8);
    margin-top: var(--z-space-8);
  }
  .z-card h2 {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--z-fg-strong);
    margin: 0 0 var(--z-space-4);
  }
  @media (min-width: 768px) {
    .z-card h2 { font-size: 1.875rem; }
  }
  .z-card h3 {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--z-fg-strong);
    margin: var(--z-space-6) 0 var(--z-space-2);
  }
  .z-card p, .z-card li {
    color: #d1d5db;
    line-height: 1.7;
  }
  .z-card ul {
    padding-left: var(--z-space-6);
  }
  .z-card li { margin-bottom: var(--z-space-2); }

  .z-two-col {
    display: grid;
    gap: var(--z-space-6);
    margin-top: var(--z-space-4);
  }
  @media (min-width: 768px) {
    .z-two-col { grid-template-columns: 1fr 1fr; }
  }

  .z-faq {
    display: flex;
    flex-direction: column;
    gap: var(--z-space-3);
  }
  .z-faq-item {
    border: 1px solid #1f2937;
    border-radius: 12px;
    padding: var(--z-space-4);
    background: rgba(2,6,23,0.6);
  }
  .z-faq-item summary {
    font-weight: 600;
    color: var(--z-fg-strong);
    cursor: pointer;
    list-style: none;
  }
  .z-faq-item summary::-webkit-details-marker { display: none; }
  .z-faq-item[open] summary { margin-bottom: var(--z-space-3); }
  .z-faq-item p { margin: 0; color: #d1d5db; }
</style>
